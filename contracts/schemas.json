{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chitmirror.local/contracts/schemas.json",
  "$defs": {
    "money": {"type": "integer", "minimum": 0, "description": "Paise, not rupees; 445007 means Rs 4,450.07."},
    "utr": {"type": ["string", "null"], "pattern": "^[0-9]{12}$"},
    "status": {"enum": ["verified", "duplicate", "wrong_amount", "needs_review"]},
    "bubble": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "status", "amount_paise", "utr", "reason"], "properties": {"type": {"const": "result_card"}, "status": {"$ref": "#/$defs/status"}, "amount_paise": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]}, "utr": {"$ref": "#/$defs/utr"}, "reason": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "item_id", "reason"], "properties": {"type": {"const": "review_request"}, "item_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "reminder"}, "text": {"type": "string", "minLength": 1}}}
      ]
    },
    "message_request": {"type": "object", "additionalProperties": false, "required": ["sender", "text"], "properties": {"sender": {"type": "string", "minLength": 1}, "text": {"type": "string"}, "image": {"type": "string", "description": "Optional binary image part in multipart/form-data."}}},
    "message_response": {"type": "object", "additionalProperties": false, "required": ["bubbles"], "properties": {"bubbles": {"type": "array", "items": {"$ref": "#/$defs/bubble"}}}},
    "review_request": {"type": "object", "additionalProperties": false, "required": ["item_id", "decision", "reason", "actor"], "properties": {"item_id": {"type": "string", "minLength": 1}, "decision": {"enum": ["approve", "reject"]}, "reason": {"type": "string", "pattern": "\\S"}, "actor": {"type": "string", "minLength": 1}}},
    "review_response": {"type": "object", "additionalProperties": false, "required": ["item_id", "decision"], "properties": {"item_id": {"type": "string"}, "decision": {"enum": ["approve", "reject"]}}},
    "member": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}},
    "ledger_entry": {"type": "object", "additionalProperties": false, "required": ["member_id", "month", "status", "amount_paise", "utr"], "properties": {"member_id": {"type": "string"}, "month": {"type": "integer", "minimum": 1}, "status": {"enum": ["verified", "needs_review", "overdue", "rejected", "pending"]}, "amount_paise": {"$ref": "#/$defs/money"}, "utr": {"$ref": "#/$defs/utr"}}},
    "flag": {"type": "object", "additionalProperties": false, "required": ["item_id", "member_id", "month", "reason"], "properties": {"item_id": {"type": "string"}, "member_id": {"type": "string"}, "month": {"type": "integer", "minimum": 1}, "reason": {"type": "string"}}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["id", "actor", "action", "reason", "timestamp"], "properties": {"id": {"type": "string"}, "actor": {"type": "string"}, "action": {"type": "string"}, "reason": {"type": "string"}, "timestamp": {"type": "string", "format": "date-time"}}},
    "state_response": {"type": "object", "additionalProperties": false, "required": ["members", "months", "ledger", "counters", "flags", "overdue", "audit_log", "statement", "private_bubbles"], "properties": {
      "members": {"type": "array", "items": {"$ref": "#/$defs/member"}}, "months": {"type": "array", "items": {"type": "integer", "minimum": 1}},
      "ledger": {"type": "array", "items": {"$ref": "#/$defs/ledger_entry"}},
      "counters": {"type": "object", "additionalProperties": false, "required": ["collected_paise", "paid", "total_members", "needs_review", "overdue"], "properties": {"collected_paise": {"$ref": "#/$defs/money"}, "paid": {"type": "integer", "minimum": 0}, "total_members": {"type": "integer", "minimum": 0}, "needs_review": {"type": "integer", "minimum": 0}, "overdue": {"type": "integer", "minimum": 0}}},
      "flags": {"type": "array", "items": {"$ref": "#/$defs/flag"}}, "overdue": {"type": "array", "items": {"$ref": "#/$defs/ledger_entry"}}, "audit_log": {"type": "array", "items": {"$ref": "#/$defs/audit"}},
      "statement": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["month", "instalment_paise", "dividend_paise", "late_fee_paise", "prize_paise", "status"], "properties": {"month": {"type": "integer", "minimum": 1}, "instalment_paise": {"$ref": "#/$defs/money"}, "dividend_paise": {"$ref": "#/$defs/money"}, "late_fee_paise": {"$ref": "#/$defs/money"}, "prize_paise": {"$ref": "#/$defs/money"}, "status": {"type": "string"}}}},
      "private_bubbles": {"type": "array", "items": {"$ref": "#/$defs/bubble"}}
    }},
    "reminders_request": {"type": "object", "additionalProperties": false, "required": ["actor"], "properties": {"actor": {"type": "string", "minLength": 1}}},
    "reminders_response": {"type": "object", "additionalProperties": false, "required": ["sent"], "properties": {"sent": {"type": "integer", "minimum": 0}}},
    "demo_load_request": {"type": "object", "additionalProperties": false, "required": ["actor"], "properties": {"actor": {"type": "string", "minLength": 1}}},
    "demo_load_response": {"type": "object", "additionalProperties": false, "required": ["loaded"], "properties": {"loaded": {"type": "boolean"}}},
    "error_response": {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}
  }
}
